#!/bin/sh
set -e
root=`dirname $0`
cd "$root"
root=`pwd`
. src/fetch/_archive
mkdir -p "$root/share/pcdev"
cd "$root"; . src/fetch/native_emu2
cd "$root"; . src/fetch/cross_aztec34
cd "$root"; . src/fetch/cross_cpm86_patch
cd "$root"; . src/fetch/cross_aztec42
cd "$root"; . src/fetch/cross_drtools
cd "$root"; . src/fetch/cross_turbo
cd "$root"; . src/fetch/native_cb86
cd "$root"; . src/fetch/cross_m2cb
cd "$root"; . src/fetch/cross_plm86
cd "$root"; . src/fetch/cross_mstools
cd "$root"; . src/fetch/native_drtools
cd "$root"; . src/fetch/native_tnylpo
cd "$root"; . src/fetch/native_nasm
cd "$root"; . src/fetch/native_upx
cd "$root"; . src/fetch/cross_aztec42_build
cd "$root"; . src/fetch/cross_aztec_startups
cd "$root"; . src/fetch/cross_xlisp
find "$root/share" -type d -exec chmod 755 {} \;
find "$root/share" -type f -exec chmod a-w {} \;
printf 'INF: %s\n' "Fetch and build completed"
exit 0

#!/bin/sh
# Run miscellaneous interpreter tests, capture output, bless or diff against .rsp.
# Called by 'make test-misc' with tool variables set in the environment.

set -e

trap "rm -f screenlog.0"  EXIT INT TERM

run_test() {
    name="$1"
    rsp="${name}.rsp"
    out="${name}.out"
    shift
    echo "--------- TEST: $*"
    eval "$@" > "$out.raw" 2>&1
    rc=$?
    tr -d '\r' < "$out.raw" > "$out"
    rm -f "$out.raw"
    if [ $rc -ne 0 ]; then
        echo "--------- ERROR: $* (exit $rc):"
        cat "$out"
        exit 1
    fi
    if [ ! -f "$rsp" ]; then
        mv "$out" "$rsp"
        echo "--------- BLESSED: $rsp"
    else
        if diff -u "$rsp" "$out" > /dev/null 2>&1; then
            echo "--------- PASS: $name"
            rm -f "$out"
        else
            echo "--------- FAIL: $name (diff $rsp vs $out):"
            diff -u "$rsp" "$out" || true
            exit 1
        fi
    fi
}

run_gwtest() {
    name="$1"
    rm -f screenlog.0
    rsp="$name.rsp"
    out="$name.out"
    screen -L -Dm pcdev_gwbasic "$name".bas
    cat screenlog.0 | grep Hello | sed -e 's/.*Hello/Hello/g' | tr -d '\r'> "$out"
    if diff -u "$rsp" "$out" > /dev/null 2>&1; then
        echo "--------- PASS: $name"
        rm -f "$out"
    else
        echo "--------- FAIL: $name (diff $rsp vs $out):"
        diff -u "$rsp" "$out" || true
        exit 1
    fi
}

run_test hellomsb  "cpm86_mbasic hellomsb.bas"
run_test hellopba  "cpm86_basic < hellopba.bas"
run_test helloi    "cpm86_crun helloi.int"
run_test helloxlp  "cpm86_xlisp helloxlp.lsp"
run_test hellocbl  "mfcobol_run hellocbl.int"
run_gwtest hellogw


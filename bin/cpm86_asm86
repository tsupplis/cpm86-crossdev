#!/bin/sh
emu2=`dirname $0`/emu2
prog=`basename $0|sed -e s'/cpm86_//g'`.cmd
EMU2_DRIVE_D="`dirname $0`/../share/cpm"
export EMU2_DRIVE_D
EMU2_PROGNAME="D:$prog"
export EMU2_PROGNAME
if [ -z "$*" ]; then
    "$emu2" "$EMU2_DRIVE_D/$prog" "$@"
    echo ""
    exit 1
fi

# ASM86 has no usable exit code under CP/M-86; a real assembly error still
# produces a .h86 file, so scan the console output and remove it ourselves.
base=`echo "$1" | sed -e 's/\.[Aa]86$//'`
tmp="${TMPDIR:-/tmp}/cpm86_asm86.`date +%s`.$$"
trap 'rm -f "$tmp"' EXIT INT TERM
"$emu2" "$EMU2_DRIVE_D/$prog" "$@" 2>&1 | tee "$tmp"
# tex06/tex12/tex13 ("... - IGNORED") are recoverable notices ASM86 itself
# marks as ignored (e.g. the ORG 100h note for XLT86-translated code); any
# other "** ERROR NO:" line is a genuine failure.
if grep '\*\* ERROR NO:' "$tmp" | grep -qv 'IGNORED'; then
    echo "ERR: cpm86_asm86: fatal assembly error(s) detected; removing $base.h86" >&2
    rm -f "$base.h86"
    exit 1
fi

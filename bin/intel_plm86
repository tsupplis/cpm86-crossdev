#!/bin/sh
prog=`basename $0|sed -e s'/intel_//g'`.exe
emu2=`dirname $0`/emu2
EMU2_APPEND=D:\\
export EMU2_APPEND
EMU2_DRIVE_D="`dirname $0`/../share/intel"
export EMU2_DRIVE_D
EMU2_PROGNAME="D:\\$prog"
export EMU2_PROGNAME
"$emu2" "$EMU2_DRIVE_D/$prog" "$@" -- PATH=D:\\ LIB=D:\\
rc=$?
if [ -z "$*" ];then 
    echo ""
fi
exit $rc

#!/bin/sh
share="`dirname $0`/../share/m2cbcpm"
emu2=`dirname $0`/emu2
emudir="`dirname $0`/../share/emu"
EMU2_APPEND="C:"
export EMU2_APPEND
EMU2_DRIVE_C="$share"
export EMU2_DRIVE_C
EMU2_DRIVE_D="`pwd`"
export EMU2_DRIVE_D
EMU2_DRIVE_P="$share"
export EMU2_DRIVE_P
EMU2_DRIVE_E="$emudir"
export EMU2_DRIVE_E
EMU2_PROGNAME="E:\\cpm86.exe"
export EMU2_PROGNAME

# Prefix bare filenames (no drive letter) with D: so the tool finds them in CWD
# Overlays are on C: alongside the tool
args=""
for arg in "$@"; do
    case "$arg" in
        [A-Za-z]:*) args="$args $arg" ;;
        *)           args="$args D:$arg" ;;
    esac
done

"$emu2" "$emudir/cpm86.exe" "C:m2cbasic" $args
if [ -z "$*" ]; then
    echo ""
fi

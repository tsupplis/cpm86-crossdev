#!/bin/sh
share="`dirname $0`/../share/f77cpm"
emu2=`dirname $0`/emu2
EMU2_CPM_APPEND="D:"
export EMU2_CPM_APPEND
EMU2_DRIVE_D="$share"
export EMU2_DRIVE_D

trap 'rm -f *.cil *.cym' EXIT INT TERM

EMU2_PROGNAME="D:f77.cmd"
export EMU2_PROGNAME
"$emu2" "$share/f77.cmd" "$@" -- PATH=D:\\
rc=$?

# if .cil was produced, codegen was not called automatically — run it
src="${@##* }"
base="${src%.*}"
if [ $rc -eq 0 ] && [ -f "${base}.cil" ]; then
    EMU2_PROGNAME="D:codegen.cmd"
    export EMU2_PROGNAME
    "$emu2" "$share/codegen.cmd" "$base" -- PATH=D:\\
    rc=$?
fi

exit $rc

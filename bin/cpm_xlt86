#!/bin/sh
cpmdir="`dirname $0`/../share/cpm"
conf=`mktemp -t tnylpo`
tnylpo=`dirname $0`/tnylpo

trap 'rm -f "$conf"' EXIT INT TERM
cat > "$conf" <<EOF
drive a = "$cpmdir"
drive b = "."
EOF
# Prefix bare filenames (no drive letter) with B:
args=""
for arg in "$@"; do
    case "$arg" in
        [A-Za-z]:*) args="$args $arg" ;;
        *)           args="$args B:$arg" ;;
    esac
done
exec "$tnylpo" -f "$conf" -d a "$cpmdir/xlt86.com" $args

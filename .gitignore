# ── Editor / OS noise ────────────────────────────────────────────────────────
**/.*.swp
**/.DS_Store
**/.vscode

# ── Generated directories at project root ────────────────────────────────────
# Download cache (persistent — not removed by clear_tools)
archive/
# Tool share trees staged by fetchers
share/
# Local user scratch area
local/

# ── Generated native binaries in bin/ ────────────────────────────────────────
bin/emu2
bin/tnylpo
bin/tnylpo-convert
bin/nasm
bin/upx
bin/cmdinfo
bin/bin2cmd
bin/exe2cmd
bin/doscat
bin/hexcom
bin/ansi2kr
bin/drpli_objfix
bin/pc
bin/crc

# ── Build artefacts ──────────────────────────────────────────────────────────
**/*.lock
**/*.log
**/*.err
**/*.o
**/*.obj
**/*.lib
**/*.lha
**/*.zip
**/*.lin
**/*.h86
**/*.r86
**/*.sym
**/*.lst
**/*.map
**/*.prn
**/*.hex

# Leave MSC51 error files
!src/mspackages/msc51/*.err

# badgencm.h86 is a committed negative-test fixture, not a build artefact
!examples/badgencm.h86

# vendor package libs/objs are shipped package content, not build output
!src/mspackages/**/*.lib
!src/mspackages/**/*.obj
!src/drpackages/**/*.lib
!src/drpackages/**/*.r86
!src/drpackages/**/*.obj
!src/inteltools/**/*.lib
!src/inteltools/**/*.obj

# ── CP/M disk images ─────────────────────────────────────────────────────────
**/hack*.img
**/cpmtest.img
**/cdostest.img
**/cpmhd.img
**/ccpm86.img
**/cpm86.img
**/cdos.img

# ── Example build outputs ────────────────────────────────────────────────────
**/hello*.cmd
**/hello*.com
**/hello*.exe
**/hello*.bin
examples/*.prt
examples/*.prn
examples/hellod.a
examples/ctemp.tok
examples/pastemp.tok
examples/comndata.*
examples/8087.sim
examples/hellocvt.cb
examples/hello86.a86
examples/*.int

src/cpmtest/*.out
src/cpmtest/*.cmd
src/cpmtest/*.obj

src/ansi2kr/ansi2kr
src/ansi2kr/*.cmd
src/ansi2kr/*.obj

docs/**/*.cmd
docs/**/*-plan.md

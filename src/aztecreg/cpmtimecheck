#!/bin/sh
# The CP/M-86 time module on DOS: its conversion routines take no OS input.
# The module is extracted from the installed c86 library.
set -eu
bin=$1
source=$(pwd)/cpmtime.c
work=$(mktemp -d "${TMPDIR:-/tmp}/azcpmtime.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
cp "$source" "$work/test.c"
cd "$work"
"$bin/aztec43_lib" 'D:\LIB\c86.lib' -x time
"$bin/aztec43_acc" -emu="$bin/emu2" -target=dos2 -o test.exe test.c time.o -lm
output=$("$bin/emu2" test.exe)
printf '%s\n' "$output"
printf '%s\n' "$output" | tr -d '\r' | grep -qx 'CPM TIME PASS'

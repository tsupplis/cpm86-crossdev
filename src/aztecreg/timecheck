#!/bin/sh
set -eu
bin=$1
source=$(pwd)/dostime.c
work=$(mktemp -d "${TMPDIR:-/tmp}/aztime.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
acc() { "$bin/aztec43_acc" -emu="$bin/emu2" "$@"; }
cp "$source" "$work/test.c"
cd "$work"
for target in c d11 clc cld cl; do
    case $target in
        c) opts=-target=dos2; out=test.exe;;
        d11) opts=-target=dos1; out=test.com;;
        clc) opts="-target=dos2 -mcmodel=medium"; out=test.exe;;
        cld) opts="-target=dos2 -mcmodel=compact"; out=test.exe;;
        cl) opts="-target=dos2 -mcmodel=large"; out=test.exe;;
    esac
    for float in soft auto 8087; do
        acc $opts -mfloat="$float" -o "$out" test.c -lm
        # emu2 has no hardware 8087; the inline library is link-checked.
        if [ "$float" = 8087 ]; then
            echo "$target/$float: DOS TIME LINK PASS (hardware 8087 required)"
            continue
        fi
        output=$("$bin/emu2" "$out")
        printf '%s: %s\n' "$target/$float" "$output"
        printf '%s\n' "$output" | tr -d '\r' | grep -qx 'DOS TIME PASS'
    done
done

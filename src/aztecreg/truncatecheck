#!/bin/sh
set -eu
bin=$1
source=$(pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/aztrunc.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
# DOS 1.1 needs the emulator's zero-count FCB write correction.
# Build it only in this disposable tree, unless a runner is supplied.
if [ -z "${TRUNCATE_EMULATOR:-}" ]; then
    mkdir -p "$work/emulator"
    cp -R "$bin/../archive/emu2/src" "$work/emulator/"
    cp "$bin/../archive/emu2/GNUmakefile" "$bin/../archive/emu2/platform.mk" "$work/emulator/"
    (cd "$work/emulator"
     git apply --no-index --whitespace=nowarn "$source/emu2-truncate.patch"
     "${MAKE:-make}" -j4)
    TRUNCATE_EMULATOR="$work/emulator/emu2"
    export TRUNCATE_EMULATOR
fi
cp "$source/truncate.c" "$work/test.c"
cd "$work"
for target in c clc cld cl d11; do
    case $target in clc) model=lc;; cld) model=ld;; cl) model=l;; *) model=;; esac
    "$bin/aztec42_cc" +"$model" +F +0 -o test.o test.c
    case $target in d11) out=run.com;; *) out=run.exe;; esac
    "$bin/aztec42_link" -o "$out" test.o -l"$target"
    output=$("${TRUNCATE_EMULATOR:-$bin/emu2}" "$out")
    printf '%s\n' "$output"
    printf '%s\n' "$output" | tr -d '\r' | grep -qx 'TRUNCATE PASS'
    if printf '%s\n' "$output" | grep -q FAIL; then exit 1; fi
    echo "TRUNCATE RUNTIME PASS: $target"
done

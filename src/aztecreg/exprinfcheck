#!/bin/sh
# Build an external expr checkout against the installed runtime, in /tmp.
set -eu
bin=$1
expr=$2
work=$(mktemp -d "${TMPDIR:-/tmp}/azexprinf.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
cp "$expr"/*.c "$expr"/*.h "$work/"
cd "$work"
for target in ${EXPR_TARGETS:-c86}; do
    case $target in
        clc) model=lc;; cld) model=ld;;
        cl) model=l;; *) model=;;
    esac
    case $target in c86) out=smoke.cmd;; d11) out=smoke.com;; *) out=smoke.exe;; esac
    "$bin/aztec42_cc" +"$model" +F +0 -I. -DREQUIRE_INFINITY -o smoke.o smoke.c
    "$bin/aztec42_cc" +"$model" +F +0 -I. -o tinyexpr.o tinyexpr.c
    "$bin/aztec42_link" -o "$out" smoke.o tinyexpr.o -lm"$model" -l"$target"
    output=$("$bin/emu2" "$out")
    printf '%s\n' "$output"
    printf '%s\n' "$output" | grep -q 'ALL TESTS PASSED'
    if printf '%s\n' "$output" | grep -qi 'skipped\|SOME TESTS FAILED'; then exit 1; fi
    printf '%s\n' "$output" | grep -Eq 'INFs[[:space:]]+pass:[1-9][0-9]*[[:space:]]+fail: 0'
    # The other programs exercised by expr's make test target.
    for demo in expl expl2 expl3 reg; do
        "$bin/aztec42_cc" +"$model" +F +0 -I. -DREQUIRE_INFINITY -o demo.o "$demo.c"
        "$bin/aztec42_link" -o "$out" demo.o tinyexpr.o -lm"$model" -l"$target"
        if [ "$demo" = expl2 ]; then
            output=$("$bin/emu2" "$out" '45+sqrt(34)')
        else
            output=$("$bin/emu2" "$out")
        fi
        printf '%s\n' "$output"
        if [ "$demo" = reg ]; then
            printf '%s\n' "$output" | tr -d '\r' | grep -qx 'MATH EDGE PASS'
        fi
    done
    echo "EXPR INF PASS: $target"
done

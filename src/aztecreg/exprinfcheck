#!/bin/sh
# Build an external expr checkout against the installed runtime, in /tmp.
set -eu
bin=$1
expr=$2
work=$(mktemp -d "${TMPDIR:-/tmp}/azexprinf.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
cp "$expr"/*.c "$expr"/*.h "$work/"
cd "$work"
acc() { "$bin/aztec43_acc" -emu="$bin/emu2" "$@"; }
for target in ${EXPR_TARGETS:-c86}; do
    case $target in
        c86) opts=-target=cpm86; out=smoke.cmd;;
        d11) opts=-target=dos1; out=smoke.com;;
        c) opts=-target=dos2; out=smoke.exe;;
        clc) opts="-target=dos2 -mcmodel=medium"; out=smoke.exe;;
        cld) opts="-target=dos2 -mcmodel=compact"; out=smoke.exe;;
        cl) opts="-target=dos2 -mcmodel=large"; out=smoke.exe;;
    esac
    acc $opts -I. -DREQUIRE_INFINITY -o "$out" smoke.c tinyexpr.c -lm
    output=$("$bin/emu2" "$out")
    printf '%s\n' "$output"
    printf '%s\n' "$output" | grep -q 'ALL TESTS PASSED'
    if printf '%s\n' "$output" | grep -qi 'skipped\|SOME TESTS FAILED'; then exit 1; fi
    printf '%s\n' "$output" | grep -Eq 'INFs[[:space:]]+pass:[1-9][0-9]*[[:space:]]+fail: 0'
    # The other programs exercised by expr's make test target.
    for demo in expl expl2 expl3 reg; do
        acc $opts -I. -DREQUIRE_INFINITY -o "$out" "$demo.c" tinyexpr.c -lm
        if [ "$demo" = expl2 ]; then
            output=$("$bin/emu2" "$out" '45+sqrt(34)')
        else
            output=$("$bin/emu2" "$out")
        fi
        printf '%s\n' "$output"
        if [ "$demo" = reg ]; then
            printf '%s\n' "$output" | tr -d '\r' | grep -qx 'MATH EDGE PASS'
        fi
    done
    echo "EXPR INF PASS: $target"
done

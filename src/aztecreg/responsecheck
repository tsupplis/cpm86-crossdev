#!/bin/sh
# Target selection must work when all linker arguments live in a response file.
set -eu
bin=$1
work=$(mktemp -d "${TMPDIR:-/tmp}/azresponse.XXXXXX")
trap 'rm -rf "$work"' EXIT HUP INT TERM
cd "$work"
cat > main.c <<'C'
#include <stdio.h>
int main(void) { puts("RESPONSE PASS"); return 0; }
C
acc() { "$bin/aztec43_acc" -emu="$bin/emu2" "$@"; }
for target in c86 d11 c clc cld cl; do
    case $target in
        c86) opts=-target=cpm86; out=main.cmd;;
        d11) opts=-target=dos1; out=main.com;;
        c) opts=-target=dos2; out=main.exe;;
        clc) opts="-target=dos2 -mcmodel=medium"; out=main.exe;;
        cld) opts="-target=dos2 -mcmodel=compact"; out=main.exe;;
        cl) opts="-target=dos2 -mcmodel=large"; out=main.exe;;
    esac
    acc $opts -c -o main.o main.c
    for ending in lf crlf; do
        rm -f "$out"
        if [ "$ending" = lf ]; then
            printf '%s\n' main.o > link.inp
        else
            printf '%s\r\n' main.o > link.inp
        fi
        acc $opts -o "$out" link.inp
        output=$("$bin/emu2" "$out")
        printf '%s\n' "$output" | tr -d '\r' | grep -qx 'RESPONSE PASS'
    done
    echo "RESPONSE LINKS PASS: $target"
done

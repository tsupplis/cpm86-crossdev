#!/bin/sh
prog=turbo.com
if [ "$#" -gt 0 ]; then
    prog=tpc.com
fi
emu2=`dirname $0`/emu2
EMU2_APPEND=D:
export EMU2_APPEND
EMU2_DRIVE_D="`dirname $0`/../share/tp3dos"
export EMU2_DRIVE_D
EMU2_PROGNAME="D:$prog"
export EMU2_PROGNAME
if [ "$#" -gt 0 ]; then
    exec "$emu2" "$EMU2_DRIVE_D/$prog" "$@" -- PATH=D:\\
fi
"$emu2" "$EMU2_DRIVE_D/$prog" "$@" -- PATH=D:\\
if [ -z "$*" ];then
    echo ""
fi

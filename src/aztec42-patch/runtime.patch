diff --git a/after/src/misc/compat.c b/after/src/misc/compat.c
new file mode 100644
index 0000000..cc450c2
--- /dev/null
+++ b/after/src/misc/compat.c
@@ -0,0 +1,51 @@
+/* Common extensions for the Aztec runtime. */
+#include <errno.h>
+
+static int lower(unsigned char c)
+{
+    return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c;
+}
+
+int strnicmp(const char *a, const char *b, unsigned n)
+{
+    int x, y;
+    while (n--) {
+        x = lower(*a++);
+        y = lower(*b++);
+        if (x != y || !x)
+            return x - y;
+    }
+    return 0;
+}
+
+void *memmove(void *dest, const void *src, unsigned n)
+{
+#if (sizeof(char *) == 4)
+    /* Far pointers with different segments can still overlap. */
+    long ptrtoabs();
+    long distance = ptrtoabs(dest) - ptrtoabs(src);
+    if (distance > 0 && distance < (long)n) {
+        char *to = dest;
+        const char *from = src;
+        while (n) {
+            --n;
+            to[n] = from[n];
+        }
+        return dest;
+    }
+#endif
+    movmem(src, dest, n);
+    return dest;
+}
+
+int remove(const char *name)
+{
+    return unlink(name);
+}
+
+char *strerror(int err)
+{
+    if (err < 0 || err >= sys_nerr || !sys_errlist[err][0])
+        return "Unknown error";
+    return sys_errlist[err];
+}

@@ -0,0 +1,8 @@
+#include <string.h>
+size_t strspn(const char *s, const char *set)
+{
+    const char *p = s;
+    while (*p && strchr(set, *p))
+        ++p;
+    return p - s;
+}
diff --git a/after/src/misc/strto.c b/after/src/misc/strto.c
new file mode 100644
index 0000000..5b09796
--- /dev/null
+++ b/after/src/misc/strto.c
@@ -0,0 +1,71 @@
+#include <ctype.h>
+#include <errno.h>
+#include <stddef.h>
+
+/* One bounded accumulator for both signed and unsigned 32-bit results. */
+static int digit(unsigned char c)
+{
+    if (c >= '0' && c <= '9')
+        return c - '0';
+    if (c >= 'A' && c <= 'Z')
+        return c - 'A' + 10;
+    if (c >= 'a' && c <= 'z')
+        return c - 'a' + 10;
+    return 36;
+}
+
+static unsigned long convert(const char *s, char **end, int base, int unsign)
+{
+    const char *start = s;
+    unsigned long value = 0, limit, cutoff;
+    int negative, any = 0, overflow = 0, d, cutlim;
+
+    if (end)
+        *end = (char *)start;
+    if (base && (base < 2 || base > 36)) {
+        errno = EINVAL;
+        return 0;
+    }
+    while ((unsigned char)*s < 128 && isspace((unsigned char)*s))
+        ++s;
+    negative = *s == '-';
+    if (*s == '+' || *s == '-')
+        ++s;
+    if ((!base || base == 16) && s[0] == '0' &&
+        (s[1] == 'x' || s[1] == 'X') && digit(s[2]) < 16) {
+        s += 2;
+        base = 16;
+    }
+    if (!base)
+        base = *s == '0' ? 8 : 10;
+    limit = unsign ? 0xffffffffUL : (negative ? 0x80000000UL : 0x7fffffffUL);
+    cutoff = limit / base;
+    cutlim = limit % base;
+    while ((d = digit(*s)) < base) {
+        any = 1;
+        if (value > cutoff || (value == cutoff && d > cutlim))
+            overflow = 1;
+        if (!overflow)
+            value = value * base + d;
+        ++s;
+    }
+    if (any && end)
+        *end = (char *)s;
+    if (overflow) {
+        errno = ERANGE;
+        value = limit;
+        if (unsign)
+            return value;
+    }
+    return negative ? 0UL - value : value;
+}
+
+long strtol(const char *s, char **end, int base)
+{
+    return (long)convert(s, end, base, 0);
+}
+
+unsigned long strtoul(const char *s, char **end, int base)
+{
+    return convert(s, end, base, 1);
+}
diff --git a/after/src/misc/strtok.c b/after/src/misc/strtok.c
new file mode 100644
index 0000000..8b11afb
--- /dev/null
+++ b/after/src/misc/strtok.c
@@ -0,0 +1,21 @@
+#include <string.h>
+char *strtok(char *s, const char *delimiters)
+{
+    static char *next;
+    char *token;
+    if (s)
+        next = s;
+    if (!next)
+        return NULL;
+    token = next + strspn(next, delimiters);
+    if (!*token) {
+        next = NULL;
+        return NULL;
+    }
+    next = token + strcspn(token, delimiters);
+    if (*next)
+        *next++ = 0;
+    else
+        next = NULL;
+    return token;
+}
diff --git a/after/src/misc/truncate.c b/after/src/misc/truncate.c
new file mode 100644
index 0000000..164061e
--- /dev/null
+++ b/after/src/misc/truncate.c
@@ -0,0 +1,18 @@
+#include <dos.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+int open(const char *, int, ...);
+
+int truncate(const char *path, long length)
+{
+    int fd, result, error;
+    if (length < 0) { errno = EINVAL; return -1; }
+    fd = open(path, O_WRONLY);
+    if (fd < 0) return -1;
+    result = ftruncate(fd, length);
+    error = errno;
+    if (close(fd) < 0 && !result) return -1;
+    if (result) errno = error;
+    return result;
+}

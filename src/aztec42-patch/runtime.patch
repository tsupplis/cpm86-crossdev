diff --git a/after/src/misc/ftrunc.c b/after/src/misc/ftrunc.c
new file mode 100644
index 0000000..f39b810
--- /dev/null
+++ b/after/src/misc/ftrunc.c
@@ -0,0 +1,41 @@
+/* DOS resize frontend: preserve position and zero-fill extensions. */
+#include <dos.h>
+#include <unistd.h>
+#include <errno.h>
+int _trcheck(int);
+int _trresize(int);
+
+int ftruncate(int fd, long length)
+{
+    static char zeros[128];
+    long position, end, remaining;
+    unsigned count;
+    int n, result, error;
+    if (length < 0) { errno = EINVAL; return -1; }
+    if (_trcheck(fd) < 0) return -1;
+    position = lseek(fd, 0L, 1);
+    if (position < 0) return -1;
+    result = -1;
+    end = lseek(fd, 0L, 2);
+    if (end >= 0) {
+        if (length <= end) {
+            if (lseek(fd, length, 0) >= 0) result = _trresize(fd);
+        } else {
+            remaining = length - end;
+            result = 0;
+            while (remaining) {
+                count = remaining > sizeof zeros ? sizeof zeros : (unsigned)remaining;
+                n = write(fd, zeros, count);
+                if (n < 0) { result = -1; break; }
+                if (n != count) { errno = ENOSPC; result = -1; break; }
+                remaining -= count;
+            }
+        }
+    }
+    error = errno;
+    if (lseek(fd, position, 0) < 0) {
+        if (!result) return -1;
+    }
+    if (result) errno = error;
+    return result;
+}
diff --git a/after/src/misc/infty.c b/after/src/misc/infty.c
new file mode 100644
index 0000000..a090b36
--- /dev/null
+++ b/after/src/misc/infty.c
@@ -0,0 +1,20 @@
+/* Intel little-endian IEEE-754 binary64. Inspect bytes without FP arithmetic. */
+union az_double { unsigned word[4]; double value; };
+const union az_double az_infinity = { { 0, 0, 0, 0x7ff0 } };
+
+static int special(const unsigned *word)
+{
+    if ((word[3] & 0x7ff0) != 0x7ff0)
+        return 0;
+    return (word[0] | word[1] | word[2] | (word[3] & 15)) ? 2 : 1;
+}
+
+int isinf(double x)
+{
+    return special((const unsigned *)&x) == 1;
+}
+
+int isnan(double x)
+{
+    return special((const unsigned *)&x) == 2;
+}

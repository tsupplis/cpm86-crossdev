--- /dev/null
+++ b/after/src/misc/atexit.c
@@ -0,0 +1,20 @@
+#include <stdlib.h>
+
+extern void (*_exitfunc)(void);
+static void (*handlers[32])(void);
+static unsigned count;
+
+static void runexit(void)
+{
+    while (count)
+        (*handlers[--count])();
+}
+
+int atexit(void (*handler)(void))
+{
+    if (count == 32)
+        return -1;
+    handlers[count++] = handler;
+    _exitfunc = runexit;
+    return 0;
+}

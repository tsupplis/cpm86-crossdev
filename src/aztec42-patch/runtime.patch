diff --git a/after/src/math/strtod.c b/after/src/math/strtod.c
new file mode 100644
index 0000000..374bbc2
--- /dev/null
+++ b/after/src/math/strtod.c
@@ -0,0 +1,113 @@
+#include <stdlib.h>
+#include <ctype.h>
+#include <errno.h>
+#include <math.h>
+
+/* Parse C89 decimal syntax, then use the existing Aztec atof arithmetic.
+ * Bound its exponent and mantissa so long input cannot wrap its 16-bit counters.
+ */
+static int compare_limit(const char *digits, unsigned n, const char *limit)
+{
+    unsigned i;
+    int d;
+    for (i = 0; i < 18; ++i) {
+        d = (i < n ? digits[i] : '0') - limit[i];
+        if (d)
+            return d;
+    }
+    return 0;
+}
+
+double strtod(const char *s, char **end)
+{
+    const char *start = s, *exponent;
+    char digits[32], *out, reverse[8];
+    long scale = 0, power = 0, magnitude;
+    unsigned n = 0, k;
+    int negative, point = 0, any = 0, exponent_negative;
+    union { double value; unsigned word[4]; } result;
+
+    if (end)
+        *end = (char *)start;
+    while ((unsigned char)*s < 128 && isspace((unsigned char)*s))
+        ++s;
+    negative = *s == '-';
+    if (*s == '-' || *s == '+')
+        ++s;
+    for (;;) {
+        if (*s >= '0' && *s <= '9') {
+            any = 1;
+            if (point)
+                --scale;
+            if (n || *s != '0') {
+                if (n < 18)
+                    digits[n++] = *s;
+                else
+                    ++scale;
+            }
+        } else if (*s == '.' && !point)
+            point = 1;
+        else
+            break;
+        ++s;
+    }
+    if (!any)
+        return 0.0;
+    if (*s == 'e' || *s == 'E') {
+        exponent = s++;
+        exponent_negative = *s == '-';
+        if (*s == '+' || *s == '-')
+            ++s;
+        if (*s < '0' || *s > '9')
+            s = exponent;
+        else {
+            do {
+                if (power < 100000L)
+                    power = power * 10 + *s - '0';
+                ++s;
+            } while (*s >= '0' && *s <= '9');
+            scale += exponent_negative ? -power : power;
+        }
+    }
+    if (end)
+        *end = (char *)s;
+    magnitude = scale + n - 1;
+    if (!n)
+        result.value = 0.0;
+    else if (magnitude > 308 || (magnitude == 308 &&
+               compare_limit(digits, n, "179769313486231570") > 0)) {
+        errno = ERANGE;
+        result.value = HUGE_VAL;
+    } else if (magnitude < -308 || (magnitude == -308 &&
+               compare_limit(digits, n, "222507385850720138") < 0)) {
+        errno = ERANGE;
+        result.value = 0.0;
+    } else {
+        out = digits + n;
+        *out++ = 'e';
+        if (scale < 0) {
+            *out++ = '-';
+            scale = -scale;
+        }
+        k = 0;
+        do {
+            reverse[k++] = '0' + scale % 10;
+            scale /= 10;
+        } while (scale);
+        while (k)
+            *out++ = reverse[--k];
+        *out = 0;
+        result.value = atof(digits);
+        if ((result.word[3] & 0x7ff0) == 0x7ff0) {
+            errno = ERANGE;
+            result.value = HUGE_VAL;
+        } else if (!(result.word[3] & 0x7ff0)) {
+            /* The software math runtime does not preserve subnormal results. */
+            errno = ERANGE;
+            result.value = 0.0;
+        }
+    }
+    if (negative)
+        result.word[3] |= 0x8000;
+    return result.value;
+}

diff --git a/after/src/math/difftime.c b/after/src/math/difftime.c
new file mode 100644
index 0000000..8412afb
--- /dev/null
+++ b/after/src/math/difftime.c
@@ -0,0 +1,19 @@
+#include <time.h>
+
+extern long _azcalday(long, int);
+
+/* Decode before subtracting: packed DOS timestamps are not seconds. */
+double difftime(time_t end, time_t beginning)
+{
+    union { time_t value; unsigned word[2]; } a, b;
+    long days, seconds;
+    a.value = end;
+    b.value = beginning;
+    days = _azcalday((long)(a.word[1]>>9)+1980, (a.word[1]>>5&15)-1)
+         - _azcalday((long)(b.word[1]>>9)+1980, (b.word[1]>>5&15)-1)
+         + (a.word[1]&31) - (b.word[1]&31);
+    seconds = ((long)(a.word[0]>>11)-(b.word[0]>>11))*3600
+            + ((long)(a.word[0]>>5&63)-(b.word[0]>>5&63))*60
+            + ((long)(a.word[0]&31)-(b.word[0]&31))*2;
+    return (double)days*86400.0 + (double)seconds;
+}
diff --git a/after/src/math/fmod.c b/after/src/math/fmod.c
new file mode 100644
index 0000000..2f95569
--- /dev/null
+++ b/after/src/math/fmod.c
@@ -0,0 +1,67 @@
+/* Binary64 remainder by integer significand division. No overflowing x/y. */
+#include <errno.h>
+union bits { unsigned w[4]; double d; };
+static void left(unsigned *a)
+{
+    int i;
+    for (i=3; i>0; --i) a[i] = (a[i]<<1) | (a[i-1]>>15);
+    a[0] <<= 1;
+}
+static void right(unsigned *a)
+{
+    int i;
+    for (i=0; i<3; ++i) a[i] = (a[i]>>1) | (a[i+1]<<15);
+    a[3] >>= 1;
+}
+static int nonzero(unsigned *a) { return a[0]|a[1]|a[2]|a[3]; }
+static void reduce(unsigned *a, unsigned *b)
+{
+    int i;
+    unsigned old, borrow, next;
+    for (i=3; i>=0; --i) {
+        if (a[i] < b[i]) return;
+        if (a[i] > b[i]) break;
+    }
+    borrow = 0;
+    for (i=0; i<4; ++i) {
+        old = a[i];
+        next = old < b[i] || (borrow && old == b[i]);
+        a[i] = old - b[i] - borrow;
+        borrow = next;
+    }
+}
+double fmod(double x, double y)
+{
+    union bits a,b;
+    int ex,ey;
+    unsigned sign;
+    a.d=x; b.d=y;
+    sign=a.w[3]&0x8000;
+    a.w[3]&=0x7fff; b.w[3]&=0x7fff;
+    ex=a.w[3]>>4; ey=b.w[3]>>4;
+    if ((ex==2047 && ((a.w[3]&15)|a.w[2]|a.w[1]|a.w[0]))
+        || (ey==2047 && ((b.w[3]&15)|b.w[2]|b.w[1]|b.w[0]))) {
+        if (ex!=2047 || !((a.w[3]&15)|a.w[2]|a.w[1]|a.w[0])) a=b;
+        a.w[3]|=8; return a.d;
+    }
+    if (ex==2047 || !nonzero(b.w)) {
+        errno=EDOM;
+        a.w[0]=a.w[1]=a.w[2]=0; a.w[3]=0x7ff8;
+        return a.d;
+    }
+    if (ey==2047 || !nonzero(a.w)) return x;
+    a.w[3]&=15; b.w[3]&=15;
+    if (ex) a.w[3]|=16;
+    else { ex=1; while (!(a.w[3]&16)) { left(a.w); --ex; } }
+    if (ey) b.w[3]|=16;
+    else { ey=1; while (!(b.w[3]&16)) { left(b.w); --ey; } }
+    if (ex<ey) return x;
+    while (ex>ey) { reduce(a.w,b.w); left(a.w); --ex; }
+    reduce(a.w,b.w);
+    if (!nonzero(a.w)) { a.w[3]=sign; return a.d; }
+    while (!(a.w[3]&16)) { left(a.w); --ex; }
+    if (ex>0) a.w[3]=(a.w[3]&15)|(ex<<4);
+    else { while (ex<1) { right(a.w); ++ex; } }
+    a.w[3]|=sign;
+    return a.d;
+}

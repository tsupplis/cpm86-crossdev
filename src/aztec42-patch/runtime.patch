diff --git a/after/src/dos11/trunc11.c b/after/src/dos11/trunc11.c
new file mode 100644
index 0000000..61dec38
--- /dev/null
+++ b/after/src/dos11/trunc11.c
@@ -0,0 +1,28 @@
+#include <io.h>
+#include <errno.h>
+int bdos(int, void *, int);
+
+int _trcheck(int fd)
+{
+    struct channel *ch;
+    if (fd < 0 || fd >= MAXCHAN) { errno = EBADF; return -1; }
+    ch = &chantab[fd];
+    if (!ch->c_read && !ch->c_write) { errno = EBADF; return -1; }
+    if (!ch->c_seek) { errno = EINVAL; return -1; }
+    if (ch->c_write != 1) { errno = EACCES; return -1; }
+    return 0;
+}
+int _trresize(int fd)
+{
+    struct fcbtab *fp;
+    int status;
+    fp = (struct fcbtab *)chantab[fd].c_arg;
+    /* The existing DOS 1.x backend uses one-byte records already. */
+    status = bdos(0x28, &fp->fcb, 0);
+    if (status) {
+        errno = status == 1 ? ENOSPC : EFAULT;
+        return -1;
+    }
+    fp->fcb.dos.f_size = fp->fcb.dos.f_record;
+    return 0;
+}

diff --git a/after/src/dos20/calday.c b/after/src/dos20/calday.c
new file mode 100644
index 0000000..7586ebe
--- /dev/null
+++ b/after/src/dos20/calday.c
@@ -0,0 +1,9 @@
+/* Gregorian day number relative to 1980-01-01; year >= 1, month 0..11. */
+long _azcalday(long year, int month)
+{
+    static int before[] = {0,31,59,90,120,151,181,212,243,273,304,334};
+    long y;
+    y = year - 1;
+    return 365L*y + y/4 - y/100 + y/400 - 722814L + before[month]
+        + (month > 1 && year%4 == 0 && (year%100 != 0 || year%400 == 0));
+}

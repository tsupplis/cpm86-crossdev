diff --git a/after/src/dos20/mktime.c b/after/src/dos20/mktime.c
new file mode 100644
index 0000000..369bdbc
--- /dev/null
+++ b/after/src/dos20/mktime.c
@@ -0,0 +1,40 @@
+#include <time.h>
+
+extern long _azcalday(long, int);
+
+time_t mktime(struct tm *p)
+{
+    long year, month, days, seconds, carry;
+    int mon;
+    union { time_t value; unsigned word[2]; } packed;
+    struct tm result;
+
+    year = (long)p->tm_year + 1900;
+    month = p->tm_mon;
+    carry = month / 12;
+    if (month % 12 < 0) --carry;
+    year += carry;
+    mon = (int)(month - carry*12);
+    /* Even extreme 16-bit day/time fields cannot reach the DOS range
+       from outside these bounds. Keep calendar arithmetic positive. */
+    if (year < 1 || year > 9999) return (time_t)-1;
+    seconds = (long)p->tm_hour*3600 + (long)p->tm_min*60 + p->tm_sec;
+    carry = seconds / 86400L;
+    if (seconds % 86400L < 0) --carry;
+    seconds -= carry*86400L;
+    days = _azcalday(year, mon) + (long)p->tm_mday - 1 + carry;
+    if (days < 0 || days >= _azcalday(2108L, 0)) return (time_t)-1;
+    year = 1980;
+    while (days >= _azcalday(year+1, 0)) ++year;
+    mon = 11;
+    while (days < _azcalday(year, mon)) --mon;
+    packed.word[1] = ((unsigned)(year-1980)<<9) | ((mon+1)<<5)
+        | (unsigned)(days-_azcalday(year, mon)+1);
+    packed.word[0] = ((unsigned)(seconds/3600)<<11)
+        | ((unsigned)(seconds/60%60)<<5) | (unsigned)(seconds%60/2);
+    /* DOS has no timezone/DST database; match localtime's civil time.
+       Return normalized fields at the packed timestamp's precision. */
+    result = *localtime(&packed.value);
+    *p = result;
+    return packed.value;
+}

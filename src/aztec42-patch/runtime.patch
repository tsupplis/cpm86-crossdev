diff --git a/after/src/dos20/trcheck.asm b/after/src/dos20/trcheck.asm
new file mode 100644
index 0000000..9dd4d4f
--- /dev/null
+++ b/after/src/dos20/trcheck.asm
@@ -0,0 +1,24 @@
+; DOS 2+ handle validation: reject every character device, including NUL.
+    include lmacros.h
+dataseg segment word public 'data'
+    extrn errno_:word
+dataseg ends
+    assume ds:dataseg
+    procdef _trcheck,<<fd,word>>
+    mov bx,fd
+    mov ax,4400h
+    int 21h
+    jc tr_error
+    test dl,80h
+    jz tr_ok
+    mov ax,1
+tr_error:
+    mov errno_,ax
+    mov ax,-1
+    pret
+tr_ok:
+    xor ax,ax
+    pret
+    pend _trcheck
+    finish
+    end

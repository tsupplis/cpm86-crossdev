diff --git a/after/src/misc/snprint.c b/after/src/misc/snprint.c
new file mode 100644
index 0000000..51af318
--- /dev/null
+++ b/after/src/misc/snprint.c
@@ -0,0 +1,35 @@
+/* format() counts every emitted character, including discarded bytes. */
+#include <stdio.h>
+
+static char *out;
+static unsigned room;
+
+static int emit(int c)
+{
+    if (room) {
+        *out++ = c;
+        --room;
+    }
+    return c & 255;
+}
+
+int vsnprintf(char *dst, size_t size, const char *fmt, va_list args)
+{
+    int count;
+    out = dst;
+    room = size ? size - 1 : 0;
+    count = format(emit, fmt, args);
+    if (size)
+        *out = 0;
+    return count;
+}
+
+int snprintf(char *dst, size_t size, const char *fmt, ...)
+{
+    va_list args;
+    int count;
+    va_start(args, fmt);
+    count = vsnprintf(dst, size, fmt, args);
+    va_end(args);
+    return count;
+}

+
+    /* Leave space for the terminator and the near allocator's rounding. */
+    if (n == (size_t)-1 ||
+        (sizeof(char *) == 2 && n > (size_t)-1 - 2 * sizeof(char *))) {
+        errno = ENOMEM;
+        return NULL;
+    }
+    copy = malloc(n + 1);
+    if (copy)
+        memcpy(copy, s, n + 1);
+    else
+        errno = ENOMEM;
+    return copy;
+}

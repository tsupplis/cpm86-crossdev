#!/usr/bin/env python3
"""Generate a binary-safe git patch between two unpacked Aztec source trees."""
import argparse
from pathlib import Path
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("original", type=Path)
parser.add_argument("updated", type=Path)
parser.add_argument("output", type=Path)
args = parser.parse_args()

def sources(root):
    if not (root / "include/stdio.h").is_file() or not (root / "src/c86.bld").is_file():
        parser.error(f"{root} is not an unpacked Aztec tree")
    return {
        path.relative_to(root)
        for folder in ("include", "src")
        for path in (root / folder).rglob("*")
        if (path.name in ("build", "makefile")
            or path.suffix in (".h", ".c", ".asm", ".bat", ".bld", ".mak"))
        and path.is_file()
    }


with tempfile.TemporaryDirectory() as work:
    for name in ("before", "after"):
        Path(work, name).mkdir()
    original = sources(args.original)
    updated = sources(args.updated)
    for path in sorted(original | updated):
        before = (args.original / path).read_bytes() if path in original else None
        after = (args.updated / path).read_bytes() if path in updated else None
        if before == after:
            continue
        for name, data in (("before", before), ("after", after)):
            if data is not None:
                target = Path(work, name, path)
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_bytes(data)
    diff = subprocess.run(["git", "-c", "core.autocrlf=false", "diff", "--no-index",
                           "--binary", "--no-ext-diff", "before", "after"],
                          cwd=work, stdout=subprocess.PIPE)
    if diff.returncode not in (0, 1):
        raise SystemExit(diff.returncode)
    args.output.write_bytes(diff.stdout)

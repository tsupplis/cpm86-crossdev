            title   'tst01e01 - BDOS fn 01eh f_attrib'

; ============================================================
; tst01e01.a86 - Test BDOS function 01Eh (f_attrib)
;
; Build:  make tst01e01.cmd
; Run:    emu2 tst01e01.cmd
;
; Sub-tests:
;   01e.01  make tstat01.tmp; set R/O attribute; AL == 0
;   01e.02  clear R/O attribute; AL == 0
;
; Expected output (no ERR: lines):
;   INF: test 01e.01 started (f_attrib)
;   INF: test 01e.01 successful
;   INF: test 01e.02 started (f_attrib)
;   INF: test 01e.02 successful
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_CLOSE    equ     10h
FN_DELETE   equ     13h
FN_ATTRIB   equ     1Eh
FN_MAKE     equ     16h
FN_EXIT     equ     0
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 01e.01 started (f_attrib)', CR, LF, '$'
msg_s01     db      'INF: test 01e.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 01e.01 failed', CR, LF, '$'

msg_t02     db      'INF: test 01e.02 started (f_attrib)', CR, LF, '$'
msg_s02     db      'INF: test 01e.02 successful', CR, LF, '$'
msg_f02     db      'ERR: test 01e.02 failed', CR, LF, '$'

; FCB for tstat01.tmp
; Bit 7 of FCB+9 (first ext byte) = R/O attribute
fcb1        db      0               ; drive
            db      'TSTAT01 '      ; filename
            db      'TMP'           ; extension
            db      0,0,0,0         ; EX S1 S2 RC
            db      0,0,0,0,0,0,0,0 ; D0-D7
            db      0,0,0,0,0,0,0,0 ; D8-D15
            db      0               ; CR
            db      0,0,0           ; R0 R1 R2

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; pre-clean stale file (ignore result)
            mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            ; create file
            mov     cx, FN_MAKE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_CLOSE
            mov     dx, offset fcb1
            int     BDOS

            ; --- test 01e.01: set R/O ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            ; set bit 7 of FCB+9 (first ext char) = R/O
            mov     bx, offset fcb1
            mov     al, 9[bx]
            or      al, 080h
            mov     9[bx], al

            mov     cx, FN_ATTRIB
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     test02

fail01:     mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

            ; --- test 01e.02: clear R/O ---
test02:     mov     cx, FN_PRINT
            mov     dx, offset msg_t02
            int     BDOS

            ; clear bit 7 of FCB+9
            mov     bx, offset fcb1
            mov     al, 9[bx]
            and     al, 07Fh
            mov     9[bx], al

            mov     cx, FN_ATTRIB
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail02

            mov     cx, FN_PRINT
            mov     dx, offset msg_s02
            int     BDOS
            jmp     done

fail02:     mov     cx, FN_PRINT
            mov     dx, offset msg_f02
            int     BDOS

done:       ; cleanup
            mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            xor     cx, cx
            int     BDOS

            end     main

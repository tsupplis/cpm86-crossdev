            title   'tst01001 - BDOS fn 010h f_close'

; ============================================================
; tst01001.a86 - Test BDOS function 010h (f_close)
;
; Build:  make tst01001.cmd
; Run:    emu2 tst01001.cmd
;
; Sub-tests:
;   010.01  open tst014aa.dat then close - expect AL=0
;
; Expected output (no ERR: lines):
;   INF: test 010.01 started (f_close)
;   INF: test 010.01 successful
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_OPEN     equ     0Fh
FN_CLOSE    equ     10h
FN_EXIT     equ     0
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 010.01 started (f_close)', CR, LF, '$'
msg_s01     db      'INF: test 010.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 010.01 failed', CR, LF, '$'

fcb1        db      0               ; drive
            db      'TST014AA'      ; filename
            db      'IN '           ; extension
            db      0,0,0,0         ; EX S1 S2 RC
            db      0,0,0,0,0,0,0,0 ; D0-D7
            db      0,0,0,0,0,0,0,0 ; D8-D15
            db      0               ; CR
            db      0,0,0           ; R0 R1 R2

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; --- test 010.01: open then close ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            mov     cx, FN_OPEN
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            mov     cx, FN_CLOSE
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     done

fail01:     mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

done:       xor     cx, cx
            int     BDOS

            end     main

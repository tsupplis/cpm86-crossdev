            title   'tst00e01 - BDOS fn 00eh drv_set'

; ============================================================
; tst00e01.a86 - Test BDOS function 00Eh (drv_set)
;
; Build:  make tst00e01.cmd
; Run:    emu2 tst00e01.cmd  (needs tst00e01.env - see below)
;
; fn 00Eh (DRV_SET) is "Select Disk": CL=0Eh, DL=drive number
; (0=A, 1=B, ... 15=P). It has no clearly defined return value,
; so this test never inspects AL from the select call itself.
; Instead each sub-test proves the selection took effect with a
; read-only fn 011h (F_SFIRST) search: the FCB drive byte is left
; at 0 ("current/default drive"), so a successful match proves
; the just-selected drive really maps to the expected directory.
;
; Host directory mapping (see tst00e01.env, sourced by 'make
; test' only for this .cmd - it must not leak into other tests,
; since it overrides where drive C: - the default drive - lives):
;   A: -> ./a  (contains marker file A_DISK)
;   B: -> ./b  (contains marker file B_DISK)
;   C: -> ./c  (contains marker file C_DISK)
;   D:..P: -> ./c  (same directory as C:, so C_DISK is found
;                   there too - this is how "every other drive"
;                   is expressed with emu2's EMU2_DRIVE_n
;                   variables; there is no implicit fallback)
;
; This test performs no writes (F_SFIRST only reads directory
; entries) - drv_set stays read-only. Each sub-test is a plain
; straight-line sequence (no loops, no shared labels) - simpler
; to follow and nothing to get subtly wrong.
;
; Sub-tests:
;   00e.01  select A(0), sfirst 'A_DISK ' - must be found
;   00e.02  select B(1), sfirst 'B_DISK ' - must be found
;   00e.03  select C(2), sfirst 'C_DISK ' - must be found
;   00e.04  select P(15), sfirst 'C_DISK ' - must be found
;           (P maps to the same directory as C)
;   00e.05  select M(12), sfirst 'M_DISK ' - must NOT be found
;           (no such marker file exists anywhere - this is the
;           negative/failure case for F_SFIRST itself)
;
; Expected output (no ERR: lines):
;   INF: test 00e.01 started (drv_set)
;   INF: test 00e.01 successful
;   INF: test 00e.02 started (drv_set)
;   INF: test 00e.02 successful
;   INF: test 00e.03 started (drv_set)
;   INF: test 00e.03 successful
;   INF: test 00e.04 started (drv_set)
;   INF: test 00e.04 successful
;   INF: test 00e.05 started (drv_set)
;   INF: test 00e.05 successful
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_DRVSET   equ     0Eh
FN_SFIRST   equ     11h
FN_EXIT     equ     0
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 00e.01 started (drv_set)', CR, LF, '$'
msg_s01     db      'INF: test 00e.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 00e.01 failed', CR, LF, '$'

msg_t02     db      'INF: test 00e.02 started (drv_set)', CR, LF, '$'
msg_s02     db      'INF: test 00e.02 successful', CR, LF, '$'
msg_f02     db      'ERR: test 00e.02 failed', CR, LF, '$'

msg_t03     db      'INF: test 00e.03 started (drv_set)', CR, LF, '$'
msg_s03     db      'INF: test 00e.03 successful', CR, LF, '$'
msg_f03     db      'ERR: test 00e.03 failed', CR, LF, '$'

msg_t04     db      'INF: test 00e.04 started (drv_set)', CR, LF, '$'
msg_s04     db      'INF: test 00e.04 successful', CR, LF, '$'
msg_f04     db      'ERR: test 00e.04 failed', CR, LF, '$'

msg_t05     db      'INF: test 00e.05 started (drv_set)', CR, LF, '$'
msg_s05     db      'INF: test 00e.05 successful', CR, LF, '$'
msg_f05     db      'ERR: test 00e.05 failed', CR, LF, '$'

; marker-file FCBs - drive byte 0 means "search the current
; (just-selected) drive", never a hard-coded drive number
fcb_a       db      0
            db      'A_DISK  '
            db      '   '
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

fcb_b       db      0
            db      'B_DISK  '
            db      '   '
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

fcb_c       db      0
            db      'C_DISK  '
            db      '   '
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

fcb_p       db      0
            db      'C_DISK  '
            db      '   '
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

fcb_m       db      0
            db      'M_DISK  '
            db      '   '
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; --- test 00e.01: select A, find A_DISK ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            mov     cx, FN_DRVSET
            mov     dl, 0
            int     BDOS

            mov     cx, FN_SFIRST
            mov     dx, offset fcb_a
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     test02

fail01:     mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

            ; --- test 00e.02: select B, find B_DISK ---
test02:     mov     cx, FN_PRINT
            mov     dx, offset msg_t02
            int     BDOS

            mov     cx, FN_DRVSET
            mov     dl, 1
            int     BDOS

            mov     cx, FN_SFIRST
            mov     dx, offset fcb_b
            int     BDOS

            cmp     al, 0FFh
            je      fail02

            mov     cx, FN_PRINT
            mov     dx, offset msg_s02
            int     BDOS
            jmp     test03

fail02:     mov     cx, FN_PRINT
            mov     dx, offset msg_f02
            int     BDOS

            ; --- test 00e.03: select C, find C_DISK ---
test03:     mov     cx, FN_PRINT
            mov     dx, offset msg_t03
            int     BDOS

            mov     cx, FN_DRVSET
            mov     dl, 2
            int     BDOS

            mov     cx, FN_SFIRST
            mov     dx, offset fcb_c
            int     BDOS

            cmp     al, 0FFh
            je      fail03

            mov     cx, FN_PRINT
            mov     dx, offset msg_s03
            int     BDOS
            jmp     test04

fail03:     mov     cx, FN_PRINT
            mov     dx, offset msg_f03
            int     BDOS

            ; --- test 00e.04: select P (maps to same dir as C), find C_DISK ---
test04:     mov     cx, FN_PRINT
            mov     dx, offset msg_t04
            int     BDOS

            mov     cx, FN_DRVSET
            mov     dl, 15
            int     BDOS

            mov     cx, FN_SFIRST
            mov     dx, offset fcb_p
            int     BDOS

            cmp     al, 0FFh
            je      fail04

            mov     cx, FN_PRINT
            mov     dx, offset msg_s04
            int     BDOS
            jmp     test05

fail04:     mov     cx, FN_PRINT
            mov     dx, offset msg_f04
            int     BDOS

            ; --- test 00e.05: select M, M_DISK does not exist anywhere ---
test05:     mov     cx, FN_PRINT
            mov     dx, offset msg_t05
            int     BDOS

            mov     cx, FN_DRVSET
            mov     dl, 12
            int     BDOS

            mov     cx, FN_SFIRST
            mov     dx, offset fcb_m
            int     BDOS

            cmp     al, 0FFh
            jne     fail05

            mov     cx, FN_PRINT
            mov     dx, offset msg_s05
            int     BDOS
            jmp     done

fail05:     mov     cx, FN_PRINT
            mov     dx, offset msg_f05
            int     BDOS

done:       xor     cx, cx
            int     BDOS

            end     main

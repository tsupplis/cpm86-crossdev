            title   'tst01301 - BDOS fn 013h f_delete'

; ============================================================
; tst01301.a86 - Test BDOS function 013h (f_delete)
;
; Build:  make tst01301.cmd
; Run:    emu2 tst01301.cmd
;
; Sub-tests:
;   013.01  make tstdl01.tmp; delete exact; open must fail
;   013.02  make tstdl01.tmp + tstdl02.tmp + tstdlxx.dat;
;           wildcard delete tstdl??.tmp;
;           open tstdl01.tmp must fail (deleted)
;   013.03  open tstdl02.tmp must fail (deleted)
;   013.04  open tstdlxx.dat must succeed (different ext, NOT deleted)
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_OPEN     equ     0Fh
FN_CLOSE    equ     10h
FN_DELETE   equ     13h
FN_MAKE     equ     16h
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 013.01 started (f_delete)', CR, LF, '$'
msg_s01     db      'INF: test 013.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 013.01 failed', CR, LF, '$'

msg_t02     db      'INF: test 013.02 started (f_delete)', CR, LF, '$'
msg_s02     db      'INF: test 013.02 successful', CR, LF, '$'
msg_f02     db      'ERR: test 013.02 failed', CR, LF, '$'

msg_t03     db      'INF: test 013.03 started (f_delete)', CR, LF, '$'
msg_s03     db      'INF: test 013.03 successful', CR, LF, '$'
msg_f03     db      'ERR: test 013.03 failed', CR, LF, '$'

msg_t04     db      'INF: test 013.04 started (f_delete)', CR, LF, '$'
msg_s04     db      'INF: test 013.04 successful', CR, LF, '$'
msg_f04     db      'ERR: test 013.04 failed', CR, LF, '$'

; exact file to delete
fcb1        db      0
            db      'TSTDL01 '
            db      'TMP'
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

; second file for wildcard test
fcb2        db      0
            db      'TSTDL02 '
            db      'TMP'
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

; survivor: different extension must NOT be deleted
fcb3        db      0
            db      'TSTDLXX '
            db      'DAT'
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

; wildcard FCB: TSTDL??.TMP  (? = 3Fh in FCB name bytes)
fcb_wc      db      0
            db      'TSTDL',03Fh,03Fh,' '   ; TSTDL?? + space
            db      'TMP'
            db      0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0,0,0,0,0,0,0,0
            db      0
            db      0,0,0

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; pre-clean all (ignore results)
            mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_DELETE
            mov     dx, offset fcb2
            int     BDOS

            mov     cx, FN_DELETE
            mov     dx, offset fcb3
            int     BDOS

            ; --- test 013.01: exact delete ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            ; create fcb1
            mov     cx, FN_MAKE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_CLOSE
            mov     dx, offset fcb1
            int     BDOS

            ; delete it
            mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            ; open must fail
            mov     cx, FN_OPEN
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            jne     fail01

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     test02

fail01:     mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

            ; --- test 013.02: wildcard delete TSTDL??.TMP ---
test02:     mov     cx, FN_PRINT
            mov     dx, offset msg_t02
            int     BDOS

            ; create fcb1, fcb2, fcb3
            mov     cx, FN_MAKE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_CLOSE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_MAKE
            mov     dx, offset fcb2
            int     BDOS

            mov     cx, FN_CLOSE
            mov     dx, offset fcb2
            int     BDOS

            mov     cx, FN_MAKE
            mov     dx, offset fcb3
            int     BDOS

            mov     cx, FN_CLOSE
            mov     dx, offset fcb3
            int     BDOS

            ; wildcard delete: TSTDL??.TMP
            mov     cx, FN_DELETE
            mov     dx, offset fcb_wc
            int     BDOS

            cmp     al, 0FFh
            je      fail02

            mov     cx, FN_PRINT
            mov     dx, offset msg_s02
            int     BDOS
            jmp     test03

fail02:     mov     cx, FN_PRINT
            mov     dx, offset msg_f02
            int     BDOS

            ; --- test 013.03: fcb1 must be gone ---
test03:     mov     cx, FN_PRINT
            mov     dx, offset msg_t03
            int     BDOS

            mov     cx, FN_OPEN
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            jne     fail03

            mov     cx, FN_PRINT
            mov     dx, offset msg_s03
            int     BDOS
            jmp     test04

fail03:     mov     cx, FN_CLOSE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_DELETE
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_PRINT
            mov     dx, offset msg_f03
            int     BDOS

            ; --- test 013.04: fcb3 (TSTDLXX.DAT) must still exist ---
test04:     mov     cx, FN_PRINT
            mov     dx, offset msg_t04
            int     BDOS

            mov     cx, FN_OPEN
            mov     dx, offset fcb3
            int     BDOS

            cmp     al, 0FFh
            je      fail04

            mov     cx, FN_CLOSE
            mov     dx, offset fcb3
            int     BDOS

            mov     cx, FN_PRINT
            mov     dx, offset msg_s04
            int     BDOS
            jmp     done

fail04:     mov     cx, FN_PRINT
            mov     dx, offset msg_f04
            int     BDOS

done:       ; cleanup survivor
            mov     cx, FN_DELETE
            mov     dx, offset fcb3
            int     BDOS

            ; also clean fcb2 if still around
            mov     cx, FN_DELETE
            mov     dx, offset fcb2
            int     BDOS

            xor     cx, cx
            int     BDOS

            end     main

            title   'i21f7 - INT 21h fn 007h direct console input'

; ============================================================
; i21f7.a86 - single call to DOS INT 21h function 007h
;
; Waits for one key with fn 007h (direct console input, no
; echo, no Ctrl-C check), prints the byte as two hex digits
; and - when the value is > 31 - the character itself, then
; exits.
;
; Build:  make i21f7.exe
; ============================================================

DOS         equ     021h
FN_DCONIN   equ     007h            ; direct console input, no echo
FN_CONOUT   equ     002h            ; display character in DL
FN_PRTSTR   equ     009h            ; print $-terminated string at DS:DX
FN_EXIT     equ     04Ch            ; terminate with return code in AL

CR          equ     00Dh
LF          equ     00Ah
SPACE       equ     020h

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA - before code so all symbols resolve in pass 1
; ============================================================

msg_banner  db      'INT 21h fn 07h - press a key', CR, LF, '$'
msg_hex     db      'hex: ', '$'
msg_open    db      '  chr: [', '$'
msg_close   db      ']', '$'
msg_crlf    db      CR, LF, '$'

; ============================================================
; CODE
; ============================================================
main:
            mov     ax, cs
            mov     ds, ax
            mov     es, ax

            mov     dx, offset msg_banner
            mov     ah, FN_PRTSTR
            int     DOS

            mov     ah, FN_DCONIN
            int     DOS
            mov     bl, al          ; BL keeps the key for the rest of the run

            mov     dx, offset msg_hex
            mov     ah, FN_PRTSTR
            int     DOS

            mov     al, bl
            mov     cl, 4
            shr     al, cl
            call    put_nib
            mov     al, bl
            call    put_nib

            cmp     bl, SPACE       ; > 31 means printable
            jb      no_char

            mov     dx, offset msg_open
            mov     ah, FN_PRTSTR
            int     DOS

            mov     dl, bl
            mov     ah, FN_CONOUT
            int     DOS

            mov     dx, offset msg_close
            mov     ah, FN_PRTSTR
            int     DOS

no_char:
            mov     dx, offset msg_crlf
            mov     ah, FN_PRTSTR
            int     DOS

            mov     ax, (FN_EXIT * 256)
            int     DOS

; ============================================================
; put_nib: print low nibble of AL as one hex digit
; ============================================================
put_nib:
            and     al, 00Fh
            add     al, '0'
            cmp     al, '9'
            jbe     put_nib_out
            add     al, 7           ; 'A'..'F'
put_nib_out:
            mov     dl, al
            mov     ah, FN_CONOUT
            int     DOS
            ret

            end     main

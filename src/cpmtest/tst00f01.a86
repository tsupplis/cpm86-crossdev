            title   'tst00f01 - BDOS fn 00fh f_open'

; ============================================================
; tst00f01.a86 - Test BDOS function 00Fh (f_open)
;
; Build:  make tst00f01.cmd
; Run:    emu2 tst00f01.cmd
;
; Sub-tests:
;   00f.01  open existing file tst014aa.dat - expect AL=0
;   00f.02  open non-existent tstxxxxx.dat  - expect AL=0FFh
;
; Expected output (no ERR: lines):
;   INF: test 00f.01 started (f_open)
;   INF: test 00f.01 successful
;   INF: test 00f.02 started (f_open)
;   INF: test 00f.02 successful
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_OPEN     equ     0Fh
FN_CLOSE    equ     10h
FN_EXIT     equ     0
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 00f.01 started (f_open)', CR, LF, '$'
msg_s01     db      'INF: test 00f.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 00f.01 failed', CR, LF, '$'

msg_t02     db      'INF: test 00f.02 started (f_open)', CR, LF, '$'
msg_s02     db      'INF: test 00f.02 successful', CR, LF, '$'
msg_f02     db      'ERR: test 00f.02 failed', CR, LF, '$'

; FCB for tst014aa.dat (drive 0 = current, 8+3 space-padded)
fcb1        db      0               ; drive
            db      'TST014AA'      ; filename
            db      'IN '           ; extension
            db      0,0,0,0         ; EX S1 S2 RC
            db      0,0,0,0,0,0,0,0 ; D0-D7
            db      0,0,0,0,0,0,0,0 ; D8-D15
            db      0               ; CR
            db      0,0,0           ; R0 R1 R2

; FCB for tstxxxxx.dat (should not exist)
fcb2        db      0               ; drive
            db      'TSTXXXXX'      ; filename
            db      'IN '           ; extension
            db      0,0,0,0         ; EX S1 S2 RC
            db      0,0,0,0,0,0,0,0 ; D0-D7
            db      0,0,0,0,0,0,0,0 ; D8-D15
            db      0               ; CR
            db      0,0,0           ; R0 R1 R2

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; --- test 00f.01: open existing file ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            mov     cx, FN_OPEN
            mov     dx, offset fcb1
            int     BDOS

            cmp     al, 0FFh
            je      fail01

            mov     cx, FN_CLOSE        ; close before next test
            mov     dx, offset fcb1
            int     BDOS

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     test02

fail01:     mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

            ; --- test 00f.02: open non-existent file ---
test02:     mov     cx, FN_PRINT
            mov     dx, offset msg_t02
            int     BDOS

            mov     cx, FN_OPEN
            mov     dx, offset fcb2
            int     BDOS

            cmp     al, 0FFh
            jne     fail02

            mov     cx, FN_PRINT
            mov     dx, offset msg_s02
            int     BDOS
            jmp     done

fail02:     mov     cx, FN_PRINT
            mov     dx, offset msg_f02
            int     BDOS

done:       xor     cx, cx
            int     BDOS

            end     main

            title   'tst00b01 - BDOS fn 00bh c_stat'

; ============================================================
; tst00b01.a86 - Test BDOS function 00Bh (c_stat)
;
; Build:  make tst00b01.cmd
; Run:    emu2 tst00b01.cmd
;
; Sub-tests:
;   00b.01  call fn 00Bh with no key pending - expect AL=0
;
; Expected output (no ERR: lines):
;   INF: test 00b.01 started (c_stat)
;   INF: test 00b.01 successful
; ============================================================

BDOS        equ     0E0h
FN_PRINT    equ     9
FN_DMASEG   equ     33h
FN_CSTAT    equ     0Bh
FN_EXIT     equ     0
CR          equ     0Dh
LF          equ     0Ah

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA
; ============================================================

msg_t01     db      'INF: test 00b.01 started (c_stat)', CR, LF, '$'
msg_s01     db      'INF: test 00b.01 successful', CR, LF, '$'
msg_f01     db      'ERR: test 00b.01 failed', CR, LF, '$'

; ============================================================
; CODE
; ============================================================
main:
            mov     cx, cs
            mov     ds, cx
            mov     es, cx

            mov     ax, cs
            mov     cx, FN_DMASEG
            mov     dx, ax
            int     BDOS

            ; --- test 00b.01: no key pending -> AL=0 ---
            mov     cx, FN_PRINT
            mov     dx, offset msg_t01
            int     BDOS

            mov     cx, FN_CSTAT
            int     BDOS

            cmp     al, 0
            jne     fail01

            mov     cx, FN_PRINT
            mov     dx, offset msg_s01
            int     BDOS
            jmp     done

fail01:     mov     cx, FN_PRINT
            mov     dx, offset msg_f01
            int     BDOS

done:       xor     cx, cx
            int     BDOS

            end     main

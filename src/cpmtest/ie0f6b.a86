            title   'ie0f6b - BDOS fn 006h raw i/o, blocking 0FDh'

; ============================================================
; ie0f6b.a86 - BDOS function 006h (c_rawio) via INT 0E0h.
;
; DL = 0FDh waits for a console character, so one call is all
; that is needed - no polling loop. The byte is printed as two
; hex digits and - when > 31 - as the character itself.
;
; Build:  make ie0f6b.cmd
; ============================================================

BDOS        equ     0E0h
FN_RAWIO    equ     006h            ; direct console i/o
FN_CONOUT   equ     002h            ; console output, char in DL
FN_PRTSTR   equ     009h            ; print $-terminated string at DS:DX
FN_EXIT     equ     000h            ; system reset

CR          equ     00Dh
LF          equ     00Ah
SPACE       equ     020h

            cseg
            org     100h

            jmp     main

; ============================================================
; DATA - before code so all symbols resolve in pass 1
; ============================================================

msg_banner  db      'BDOS fn 06h DL=0FDh blocking - press a key', CR, LF, '$'
msg_hex     db      'hex: ', '$'
msg_open    db      '  chr: [', '$'
msg_close   db      ']', '$'
msg_crlf    db      CR, LF, '$'

; ============================================================
; CODE
; ============================================================
main:
            mov     ax, cs
            mov     ds, ax
            mov     es, ax

            mov     cx, FN_PRTSTR
            mov     dx, offset msg_banner
            int     BDOS

            mov     cx, FN_RAWIO
            mov     dl, 0FDh
            int     BDOS
            mov     bl, al          ; BL keeps the key for the rest of the run

            mov     cx, FN_PRTSTR
            mov     dx, offset msg_hex
            int     BDOS

            mov     al, bl
            mov     cl, 4
            shr     al, cl
            call    put_nib
            mov     al, bl
            call    put_nib

            cmp     bl, SPACE       ; > 31 means printable
            jb      no_char

            mov     cx, FN_PRTSTR
            mov     dx, offset msg_open
            int     BDOS

            mov     cx, FN_CONOUT
            mov     dl, bl
            int     BDOS

            mov     cx, FN_PRTSTR
            mov     dx, offset msg_close
            int     BDOS

no_char:
            mov     cx, FN_PRTSTR
            mov     dx, offset msg_crlf
            int     BDOS

            xor     cx, cx
            int     BDOS

; ============================================================
; put_nib: print low nibble of AL as one hex digit
; ============================================================
put_nib:
            and     al, 00Fh
            add     al, '0'
            cmp     al, '9'
            jbe     put_nib_out
            add     al, 7           ; 'A'..'F'
put_nib_out:
            mov     cx, FN_CONOUT
            mov     dl, al
            int     BDOS
            ret

            end     main

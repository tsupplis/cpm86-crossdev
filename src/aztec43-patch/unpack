#!/bin/sh
set -eu

test -d src && test -f bin/arcv.com || {
    echo "Run unpack from the Aztec installation root" >&2
    exit 1
}
cd src
for archive in *.arc; do
    dir=${archive%.arc}
    mkdir -p "$dir"
    cp "$archive" "$dir/$archive"
    (cd "$dir" && ../../../../bin/emu2 ../../bin/arcv.com "$archive" && rm "$archive")
done
mv build/* .
mv s screen
mv g graphics
rmdir build
mv cpm86/c86.bld misc/misc.bld .
for source in *.bat *.bld */*.c */*.asm makefile */makefile; do
    dos2unix "$source"
    unix2dos "$source"
done
touch ../unpacked

[exit 0]
@end

@case compile-include-lib-dirs
-###
-toolroot=@ROOT@
-Iinc1
-Llibs1
main.c
-lpick
@out
acc: plan stage=link target=cpm86 model=small cpu=i8086
acc: plan float=soft language=default optimize=default
acc: E: is a symbolic private workspace; no files are created
tool: "D:\\bin\\cc.exe" "+0" "-b" "-n" "-D__CPM86__=1" "-IC:\\inc1" "-ID:\\include" "-o" "E:\\u0001.o" "C:\\main.c"
tool: "D:\\bin\\ln.exe" "-f" "E:\\u0003.rsp"
response: "E:\\u0003.rsp" "-o" "E:\\u0002.cmd" "D:\\lib\\begin86.o" "E:\\u0001.o" "C:\\libs1\\pick.lib" "D:\\lib\\c86.lib"
publish: "E:\\u0002.cmd" -> "C:\\a.cmd"
[exit 0]
@end


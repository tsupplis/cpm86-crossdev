tool: "D:\\bin\\cc.exe" "+0" "-b" "-n" "+e" "+f" "-s" "-D__CPM86__=1" "-ID:\\include" "-o" "E:\\u0001.o" "C:\\main.c"
publish: "E:\\u0001.o" -> "C:\\main.o"
[exit 0]
@end


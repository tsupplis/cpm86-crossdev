# Compile (-c), compile to assembly (-S) and assemble inputs.
# Format: see run-plan.sh.



























@case assemble-186
-###
-toolroot=@ROOT@
-c
-march=i80186
entry.asm
@out
acc: plan stage=object target=none model=small cpu=i80186
acc: plan float=soft optimize=default debug=off
acc: E: is a symbolic private workspace; no files are created
tool: "D:\\bin\\as.exe" "-186" "-D__i186__=1" "-ID:\\include" "-o" "E:\\u0001.o" "C:\\entry.asm"
publish: "E:\\u0001.o" -> "C:\\entry.o"
[exit 0]
@end


# Link plans: targets, models, math libraries, overlays, response file.
# Format: see run-plan.sh.

























@case link-default-name
-###
-toolroot=@ROOT@
main.o
@out
acc: plan stage=link target=cpm86 model=small cpu=i8086
acc: plan float=soft optimize=default ansi=native debug=off
acc: E: is a symbolic private workspace; no files are created
tool: "D:\\bin\\ln.exe" "-f" "E:\\u0002.rsp"
response: "E:\\u0002.rsp" "-o" "E:\\u0001.cmd" "D:\\lib\\begin86.o" "C:\\main.o" "D:\\lib\\c86.lib"
publish: "E:\\u0001.cmd" -> "C:\\a.cmd"
[exit 0]
@end

@case link-default
-###
-toolroot=@ROOT@
main.c
-o
hello.cmd
@out
acc: plan stage=link target=cpm86 model=small cpu=i8086
acc: plan float=soft optimize=default ansi=native debug=off
acc: E: is a symbolic private workspace; no files are created
tool: "D:\\bin\\cc.exe" "+0" "-b" "-n" "-ID:\\include" "-o" "E:\\u0001.o" "C:\\main.c"
tool: "D:\\bin\\ln.exe" "-f" "E:\\u0003.rsp"
response: "E:\\u0003.rsp" "-o" "E:\\u0002.cmd" "D:\\lib\\begin86.o" "E:\\u0001.o" "D:\\lib\\c86.lib"
publish: "E:\\u0002.cmd" -> "C:\\hello.cmd"
[exit 0]
@end


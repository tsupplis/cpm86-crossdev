#!/bin/sh

set -e

echo INF: Checking cmdtools ...
mkdir -p "$root/archive"
if [ ! -d "$root/archive/cmdtools" ]; then
    git clone "https://github.com/tsupplis/cpm86-cmdtools" "$root/archive/cmdtools"
    rm -rf "$root/archive/cmdtools/.git"
fi
if [ ! -f "$root/bin/cmdinfo" -o ! -f "$root/bin/bin2cmd" \
    -o ! -f "$root/bin/exe2cmd" -o ! -f "$root/bin/cmdmod" \
    -o ! -f "$root/bin/h862bin" -o ! -f "$root/bin/bin2asm" ]; then
    ncpus="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || getconf NPROCESSORS_ONLN 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '%s\n' 1)"
    (cd "$root/archive/cmdtools"; "${MAKE:-make}" -j "$ncpus" CC="${CC:-cc}" LD="${CC:-cc}")
    cp "$root/archive/cmdtools/cmdinfo" "$root/bin/cmdinfo"
    cp "$root/archive/cmdtools/bin2cmd" "$root/bin/bin2cmd"
    cp "$root/archive/cmdtools/exe2cmd" "$root/bin/exe2cmd"
    cp "$root/archive/cmdtools/cmdmod" "$root/bin/cmdmod"
    cp "$root/archive/cmdtools/h862bin" "$root/bin/h862bin"
    cp "$root/archive/cmdtools/bin2asm" "$root/bin/bin2asm"
fi

#!/bin/sh
# The linker wrappers prepend the startup matching the library and memory model.
set -e
root=${root:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
if [ "$#" -eq 0 ]; then set -- aztec34 aztec42; fi
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
extract_startup() {
    archive=$1 member=$2 output=$3
    [ -f "$lib/$archive" ] || return 0
    if [ -z "${AZTEC_REFRESH_STARTUPS:-}" ] && [ -f "$lib/$output" ] && [ ! "$lib/$archive" -nt "$lib/$output" ]; then
        return 0
    fi
    # sbegin and lbegin are reused as member names in mixed-model libraries.
    (cd "$work" && "$root/bin/${az}_lib" "D:\\LIB\\$archive" -x "$member")
    mv -f "$work/$member.o" "$lib/$output"
}

for az do
    case $az in aztec34|aztec42) ;; *) echo "Unknown Aztec version $az" >&2; exit 2;; esac
    lib="$root/share/$az/lib"
    [ -d "$lib" ] || continue
    extract_startup c86.lib begin begin86.o
    extract_startup d11.lib begin begin11.o
    extract_startup c.lib sbegin sbegin.o
    extract_startup cl.lib lbegin lbegin.o
    extract_startup clc.lib sbegin beginlc.o
    extract_startup cld.lib lbegin beginld.o
done

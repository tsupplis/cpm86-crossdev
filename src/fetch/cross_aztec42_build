#!/bin/sh

set -e
root=${root:-$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)}
if [ -z "${MAKE:-}" ] && command -v gmake >/dev/null 2>&1; then
    export MAKE="$(command -v gmake)"
fi
case ${1:-} in
    --rebuild) rm -f "$root/share/aztec42/built" ;;
    '') ;;
    *) echo "Usage: cross_aztec42_build [--rebuild]" >&2; exit 2 ;;
esac

echo INF: Unpacking Aztec 4.2 ...
if [ ! -f "$root/share/aztec42/unpacked" ]; then
    (cd "$root/share/aztec42" && "$root/src/aztec42-patch/unpack")
fi
echo INF: Patching Aztec 4.2 ...
(cd "$root/share/aztec42" && "$root/src/aztec42-patch/apply_patches")
echo INF: Building Aztec 4.2 ...
if [ ! -f "$root/share/aztec42/built" ]; then
    chmod 755 "$root/share/aztec42/src/build"
    (cd "$root/share/aztec42/src" && PATH="$root/bin:$PATH" ./build)
    mv -f "$root/share/aztec42/src/libs"/* "$root/share/aztec42/lib"
    mv -f "$root/share/aztec42/src/screen"/*.lib "$root/share/aztec42/lib"
    AZTEC_REFRESH_STARTUPS=1 sh "$root/src/fetch/cross_aztec_startups" aztec42
    touch "$root/share/aztec42/built"
fi
if [ ! -f "$root/share/aztec42/tools_built" ]; then
    (cd "$root/src/tools" && "${MAKE:-make}")
    touch "$root/share/aztec42/tools_built"
fi

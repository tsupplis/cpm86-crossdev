#!/bin/sh

set -e
build="$root/archive/aztec43"
installed="$root/share/aztec43"
mkdir -p "$root/archive" "$root/share"
work=$(mktemp -d "$root/archive/aztec43-work.XXXXXX")
trap 'rm -rf "$work"' EXIT

echo INF: Preparing Aztec 4.3 build tree ...
if [ ! -d "$build" ]; then
    if [ -d "$installed/src" ]; then
        # Import sources, header edits, original binaries, and patch/build state.
        cp -R "$installed" "$work/aztec43"
    else
        fetch_get "https://www.aztecmuseum.ca/AztecC86.zip"
        (cd "$work" && unzip -L "$ARCHIVED_FILE")
        mkdir -p "$work/aztec43/src"
        cp -R "$work/aztecc86/bin" "$work/aztecc86/lib" \
              "$work/aztecc86/include" "$work/aztec43/"
        cp -R "$work/aztecc86/arc/." "$work/aztec43/src/"
        if [ -d "$work/aztecc86/obj" ]; then
            cp -R "$work/aztecc86/obj/." "$work/aztec43/lib/"
        fi
    fi
    chmod -R u+w "$work/aztec43"
    mv "$work/aztec43" "$build"
fi
if [ ! -d "$build/src" ] || [ ! -f "$build/bin/cc.exe" ]; then
    echo "ERR: Incomplete build tree at $build; preserve local edits before restoring it." >&2
    exit 1
fi
if [ -d "$installed/src" ]; then
    if ! diff -r "$installed/src" "$build/src" >/dev/null; then
        echo "ERR: Installed and archived Aztec sources differ; reconcile them before installing." >&2
        exit 1
    fi
    if ! diff -r "$installed/include" "$build/include" >/dev/null; then
        echo "ERR: Installed and archived Aztec headers differ; reconcile them before installing." >&2
        exit 1
    fi
fi

# Read-only share files become editable only in the preserved build tree.
chmod -R u+w "$build"
if [ ! -f "$build/unpacked" ] && [ ! -f "$build/src/dos11.arc" ]; then
    fetch_get "https://www.aztecmuseum.ca/az8634b.zip"
    unzip -p "$ARCHIVED_FILE" AZ8634B/SRC/DOS11.ARC > "$work/dos11.arc"
    mv "$work/dos11.arc" "$build/src/dos11.arc"
fi
if [ ! -f "$build/bin/cc.exe.bak" ]; then
    (cd "$root/archive" && sh "$root/src/aztec43-patch/patch_aztec43_batch")
fi

echo INF: Unpacking and patching Aztec 4.3 ...
if [ ! -f "$build/unpacked" ]; then
    (cd "$build" && "$root/src/aztec43-patch/unpack")
fi
(cd "$build" && "$root/src/aztec43-patch/apply_patches")
export AZTEC43_ROOT="$build"
echo INF: Building Aztec 4.3 ...
refresh_startups=
if [ ! -f "$build/built" ]; then
    chmod u+x "$build/src/build"
    (cd "$build/src" && PATH="$root/bin:$PATH" ./build)
    cp -f "$build/src/libs/"* "$build/lib/"
    cp -f "$build/src/screen/"*.lib "$build/lib/"
    refresh_startups=1
fi
lib="$build/lib"
extract_startup() {
    archive=$1 member=$2 output=$3
    [ -f "$lib/$archive" ] || return 0
    if [ -z "$refresh_startups" ] && [ -f "$lib/$output" ] && [ ! "$lib/$archive" -nt "$lib/$output" ]; then
        return 0
    fi
    (cd "$work" && "$root/bin/aztec43_lib" "D:\\LIB\\$archive" -x "$member")
    mv -f "$work/$member.o" "$lib/$output"
}
extract_startup c86.lib begin begin86.o
extract_startup d11.lib begin begin11.o
extract_startup c.lib sbegin sbegin.o
extract_startup cl.lib lbegin lbegin.o
extract_startup clc.lib sbegin beginlc.o
extract_startup cld.lib lbegin beginld.o
if [ -n "$refresh_startups" ]; then touch "$build/built"; fi
(cd "$root/src/tools" && "${MAKE:-make}")

echo INF: Installing Aztec 4.3 runtime tools ...
mkdir -p "$installed/bin" "$installed/include" "$installed/lib"
cp -R "$build/bin/." "$installed/bin/"
cp -R "$build/include/." "$installed/include/"
cp -R "$build/lib/." "$installed/lib/"
rm -f "$installed/bin/arcv.com" "$installed/bin/c.exe" \
      "$installed/bin/cc.exe.bak" "$installed/bin/crc.exe" \
      "$installed/bin/diff.exe" "$installed/bin/grep.exe" \
      "$installed/bin/ls.com" "$installed/bin/ls.exe" \
      "$installed/bin/rm.c" "$installed/bin/rm.exe" \
      "$installed/bin/z.exe" "$installed/bin/term.exe" \
      "$installed/bin/hd.com" "$installed/bin/ctags.com" \
      "$installed/bin/ctoeng.com" "$installed/bin/engtoc.com"
if [ -d "$installed/src" ]; then rm -rf "$installed/src"; fi
rm -f "$installed/built" "$installed/unpacked" "$installed/tools_built" \
      "$installed/patched-runtime"

echo INF: Building and installing acc driver ...
"${MAKE:-make}" -C "$root/src/aztec43-acc" install INSTALL_ROOT="$installed"

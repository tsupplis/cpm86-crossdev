#!/bin/sh

set -e

echo INF: Checking Aztec 4.2 tools ...
if [ ! -d "$root/share/aztec42/bin" ]; then
    fetch_get "https://www.aztecmuseum.ca/AztecC86.zip"
    tmp="$root/archive/temp-aztec42"
    rm -rf "$tmp"
    mkdir -p "$tmp"
    trap 'rm -rf "$tmp"' EXIT
    (cd "$tmp" && unzip -L "$ARCHIVED_FILE")
    mkdir -p "$root/share/aztec42/src"
    cp -R "$tmp/aztecc86/bin"     "$root/share/aztec42/bin"
    cp -R "$tmp/aztecc86/lib"     "$root/share/aztec42/lib"
    # current AztecC86.zip doesn't have obj/, so
    # only copy it if actually present.
    [ -d "$tmp/aztecc86/obj" ] && cp -R "$tmp/aztecc86/obj" "$root/share/aztec42/obj"
    cp -R "$tmp/aztecc86/arc/." "$root/share/aztec42/src"
    cp -R "$tmp/aztecc86/include" "$root/share/aztec42/include"
    rm -rf "$tmp"
    trap - EXIT
fi

# DOS 1.x sources ship with 3.4. Older installations nested src twice.
az42src="$root/share/aztec42/src"
if [ ! -f "$root/share/aztec42/unpacked" ] && [ ! -f "$az42src/dos11.arc" ]; then
    az34src="$root/share/aztec34/src"
    [ -f "$az34src/dos11.arc" ] || az34src="$az34src/src"
    cp "$az34src/dos11.arc" "$az42src/dos11.arc"
fi

echo INF: Patching Aztec 4.2 cc.exe for default batch mode ...
cc42="$root/share/aztec42/bin/cc.exe"
if [ -f "$cc42" ] && [ ! -f "$cc42.bak" ]; then
    (cd "$root/share" && sh "$root/src/patch/patch_aztec42_batch")
fi

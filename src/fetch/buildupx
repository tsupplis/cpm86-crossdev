#!/bin/sh

set -e

echo INF: Checking UPX ...
cd "$root"
if [ ! -d upx ];then
    fetch_get "https://github.com/upx/upx/releases/download/v5.2.1/upx-5.2.1-src.tar.xz"
    tar zxf "$ARCHIVED_FILE" || tar axf "$ARCHIVED_FILE"
    mv upx-5.2.1-src upx
fi
if [ ! -f build/release/upx ];then
    ncpus="$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || getconf NPROCESSORS_ONLN 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || printf '%s\n' 1)"
    (cd upx;"${MAKE:-make}" -j"$ncpus";cp ./build/release/upx ../bin)
fi
